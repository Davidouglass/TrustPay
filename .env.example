# Neon (or any Postgres). DATABASE_URL = pooled connection, DIRECT_URL = direct connection (used for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/trustpay?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/trustpay?sslmode=require"

# Session signing key (min 32 chars). Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string-of-32+-characters"

# --- Kora (TEST MODE ONLY: must be an sk_test_ key; the app refuses live keys) ---
KORA_SECRET_KEY="sk_test_replace_me"
# Where this app is reachable by the BROWSER (Kora redirects the customer back here)
APP_URL="http://localhost:3000"
# Public HTTPS URL Kora can call (use a tunnel locally), e.g. https://abc123.ngrok-free.app/api/webhooks/kora
KORA_NOTIFICATION_URL=""
